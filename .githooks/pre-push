#!/usr/bin/env bash
# pre-push — block an agent from pushing to a human-controlled branch.
# Enable with: git config core.hooksPath .githooks
# This is the LOCAL defense layer. Server-side branch protection is the un-bypassable one.

set -euo pipefail

PROTECTED_REGEX='^(main|develop|release/.*|hotfix/.*)$'

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # remote_ref looks like refs/heads/<branch>
  branch="${remote_ref#refs/heads/}"

  if [[ "$branch" =~ $PROTECTED_REGEX ]]; then
    echo "✗ pre-push: pushing straight to '$branch' is forbidden." >&2
    echo "  This branch is human-controlled. Agents only push feature/* and open PRs into develop." >&2
    echo "  If you are a human doing this intentionally: bypass the hook with 'git push --no-verify'." >&2
    exit 1
  fi

  # Branch deletion: local_sha is all-zeros. This is NOT a force-push (no history
  # rewrite). Protected branches were already blocked by the check above; other
  # branches may be deleted. Without this skip, the guard below would run
  # 'merge-base --is-ancestor <sha> 0000…' which always fails → wrongly blocking
  # every legitimate branch deletion.
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Block force-push (agents must not rewrite shared branch history)
  if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "✗ pre-push: force-push (non-fast-forward) detected on '$branch'." >&2
      echo "  Agents must not rewrite already-pushed history." >&2
      exit 1
    fi
  fi
done

exit 0
