#!/usr/bin/env bash
# pre-commit — block a direct commit when HEAD is on a human-controlled branch.
# Catches early the case where an agent accidentally checked out the wrong branch and committed.

set -euo pipefail

PROTECTED_REGEX='^(main|develop|release/.*|hotfix/.*)$'
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

if [[ "$branch" =~ $PROTECTED_REGEX ]]; then
  echo "✗ pre-commit: on branch '$branch' — direct commits are forbidden." >&2
  echo "  Switch to your feature/<task> branch and commit again." >&2
  exit 1
fi

exit 0
