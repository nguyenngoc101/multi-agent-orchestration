#!/usr/bin/env bash
# pre-commit — chặn commit trực tiếp khi HEAD đang ở nhánh do người kiểm soát.
# Bắt sớm trường hợp agent lỡ checkout nhầm nhánh rồi commit.

set -euo pipefail

PROTECTED_REGEX='^(main|develop|release/.*|hotfix/.*)$'
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

if [[ "$branch" =~ $PROTECTED_REGEX ]]; then
  echo "✗ pre-commit: đang ở nhánh '$branch' — cấm commit trực tiếp." >&2
  echo "  Chuyển sang feature/<task> của bạn rồi commit lại." >&2
  exit 1
fi

exit 0
